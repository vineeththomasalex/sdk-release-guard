{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SDK Release Guard comparison report 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "baseline", "candidate", "failOn", "passed", "summary", "findings"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "baseline": { "$ref": "#/$defs/snapshot" },
    "candidate": { "$ref": "#/$defs/snapshot" },
    "failOn": { "enum": ["breaking", "warning", "none"] },
    "passed": { "type": "boolean" },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["breaking", "warnings", "informational"],
      "properties": {
        "breaking": { "type": "integer", "minimum": 0 },
        "warnings": { "type": "integer", "minimum": 0 },
        "informational": { "type": "integer", "minimum": 0 }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["ruleId", "severity", "subject", "message"],
        "properties": {
          "ruleId": { "type": "string", "pattern": "^SRG[0-9]{3}$" },
          "severity": { "enum": ["breaking", "warning", "info"] },
          "subject": { "type": "string", "minLength": 1 },
          "message": { "type": "string", "minLength": 1 }
        }
      }
    }
  },
  "$defs": {
    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fileName", "sha256", "architecture", "format", "exports", "imports"],
      "properties": {
        "fileName": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "architecture": { "enum": ["x86", "x64", "arm64"] },
        "format": { "enum": ["PE32", "PE32+"] },
        "exports": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["ordinal", "names", "forwarder"],
            "properties": {
              "ordinal": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
              "names": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
              "forwarder": { "type": ["string", "null"] }
            }
          }
        },
        "imports": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "delayLoaded", "symbols"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "delayLoaded": { "type": "boolean" },
              "symbols": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["name", "ordinal", "identity"],
                  "properties": {
                    "name": { "type": ["string", "null"] },
                    "ordinal": { "type": ["integer", "null"], "minimum": 0, "maximum": 65535 },
                    "identity": { "type": "string", "minLength": 1 }
                  },
                  "oneOf": [
                    { "properties": { "name": { "type": "string", "minLength": 1 }, "ordinal": { "type": "null" } } },
                    { "properties": { "name": { "type": "null" }, "ordinal": { "type": "integer" } } }
                  ]
                }
              }
            }
          }
        }
      }
    }
  }
}
